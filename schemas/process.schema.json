{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factory:schema:process",
  "title": "PROC: process",
  "description": "A To-Be (or As-Is) process. The diagram is in the body.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "created_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROC-\\d{2,}$"
    },
    "type": {
      "const": "process"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^(?:agent|human|script):[a-z0-9][a-z0-9-]*$"
    },
    "approval": {
      "type": "string",
      "pattern": "^APR-\\d{2,}$"
    },
    "level": {
      "enum": [
        "L2",
        "L3",
        "L4"
      ]
    },
    "as_is": {
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?(?:BR-\\d{2,}))$"
          }
        }
      }
    }
  },
  "$defs": {
    "ref_SH": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?SH-\\d{2,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "review",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "level"
        ]
      }
    }
  ]
}
