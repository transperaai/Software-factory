{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factory:schema:approval",
  "title": "APR: approval",
  "description": "Who approved which version of which record, in what role, on whose behalf.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "created_by",
    "decision",
    "approver",
    "role",
    "date",
    "links"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^APR-\\d{2,}$"
    },
    "type": {
      "const": "approval"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^(?:agent|human|script):[a-z0-9][a-z0-9-]*$"
    },
    "approval": {
      "type": "string",
      "pattern": "^APR-\\d{2,}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "changes_requested"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "on_behalf_of": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "accepted_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comment": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?(?:SRC-\\d{2,}|CLM-\\d{2,}|SH-\\d{2,}|PP-\\d{2,}|KPI-\\d{2,}|BR-\\d{2,}|PER-\\d{2,}|TERM-\\d{2,}|DEC-\\d{2,}|RULE-\\d{2,}|PROC-\\d{2,}|UC-\\d{2,}|WF-\\d{2,}|US-\\d{2,}|FR-\\d{2,}|NFR-\\d{2,}|ENT-\\d{2,}|INT-\\d{2,}|SL-\\d{2,}|ADR-\\d{2,}|THR-\\d{2,}|SEC-\\d{2,}|TC-\\d{2,}|UAT-\\d{2,}|REL-\\d+\\.\\d+(?:\\.\\d+)?|DEF-\\d{2,}|ISS-\\d{2,}|CR-\\d{2,}|TD-\\d{2,}|APR-\\d{2,})@\\d+)$"
          }
        }
      },
      "required": [
        "approves"
      ]
    }
  },
  "$defs": {
    "ref_SH": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?SH-\\d{2,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "review",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision",
          "approver",
          "role",
          "date",
          "links"
        ],
        "properties": {
          "links": {
            "type": "object",
            "required": [
              "approves"
            ]
          }
        }
      }
    }
  ]
}
