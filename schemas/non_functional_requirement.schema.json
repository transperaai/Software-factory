{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factory:schema:non_functional_requirement",
  "title": "NFR: non_functional_requirement",
  "description": "A quality target as a number, with how it is verified.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "created_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NFR-\\d{2,}$"
    },
    "type": {
      "const": "non_functional_requirement"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^(?:agent|human|script):[a-z0-9][a-z0-9-]*$"
    },
    "approval": {
      "type": "string",
      "pattern": "^APR-\\d{2,}$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "$defs": {
    "ref_SH": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?SH-\\d{2,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "review",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "category",
          "target",
          "verification"
        ]
      }
    }
  ]
}
