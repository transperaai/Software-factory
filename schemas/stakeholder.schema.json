{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factory:schema:stakeholder",
  "title": "SH: stakeholder",
  "description": "A named person. Scoring fields come later.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "created_by",
    "name",
    "role",
    "organisation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SH-\\d{2,}$"
    },
    "type": {
      "const": "stakeholder"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^(?:agent|human|script):[a-z0-9][a-z0-9-]*$"
    },
    "approval": {
      "type": "string",
      "pattern": "^APR-\\d{2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "organisation": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "$defs": {
    "ref_SH": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?SH-\\d{2,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "review",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "name",
          "role",
          "organisation"
        ]
      }
    }
  ]
}
