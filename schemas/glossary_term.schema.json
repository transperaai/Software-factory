{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:factory:schema:glossary_term",
  "title": "TERM: glossary_term",
  "description": "An agreed definition. The title is the term.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "created_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TERM-\\d{2,}$"
    },
    "type": {
      "const": "glossary_term"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "type": "string",
      "pattern": "^(?:agent|human|script):[a-z0-9][a-z0-9-]*$"
    },
    "approval": {
      "type": "string",
      "pattern": "^APR-\\d{2,}$"
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "$ref": "#/$defs/ref_SH"
    },
    "not_to_be_confused_with": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "system_field": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "$defs": {
    "ref_SH": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*:)?SH-\\d{2,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "review",
              "approved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "definition",
          "owner"
        ]
      }
    }
  ]
}
