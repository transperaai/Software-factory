{
  "name": "@factory/schemas",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "factory-schema-check": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node --experimental-strip-types src/generate.ts",
